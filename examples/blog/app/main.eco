/**
 * The blog API over HTTP, on a real MySQL or MariaDB.
 *
 *   blog --url mysql://app:secret@127.0.0.1:3306/blog [--port 8089]
 *   BLOG_MYSQL_URL=mysql://... blog
 *
 * Creates fresh tables with a few users, posts and comments, then serves
 * every routed action of the container:
 *
 *   curl 'localhost:8089/posts?include=author,comments.author,stats'
 *   curl -H 'X-User: 1' 'localhost:8089/users/1?include=posts'
 *   curl -H 'Accept: application/xml' 'localhost:8089/digest?include=latest.author,editor'
 */

use blog::{User, Post, Comment, Status, UserRepository, PostRepository, CommentRepository};
use std::env;
use std::io;

array<string> $argv = env::argv();
string $url = string::from(env::var('BLOG_MYSQL_URL') ?? '');
int32 $port = 8089;
usize $i = 1;
while ($i + 1 < $argv->count()) {
    if ($argv[$i] == '--url') {
        $url = $argv[$i + 1];
    } else if ($argv[$i] == '--port') {
        int64 $p = guard str::int($argv[$i + 1]) else {
            die('--port takes a number');
        };
        $port = $p as int32;
    }
    $i = $i + 2;
}
if ($url->empty()) {
    io::println('usage: blog --url mysql://user:pass@host:3306/db [--port 8089]');
    io::println('       or set BLOG_MYSQL_URL');
    env::exit(1);
}

// a pool, so every request thread gets a connection of its own
carbon::mysql::Source $source = guard carbon::mysql::Source::parse($url) else ($e) {
    die("url: {$e}");
};
carbon::DB $db = carbon::DB($source);
guard $db->register<UserRepository>();
guard $db->register<PostRepository>();
guard $db->register<CommentRepository>();
guard blog::Carbon::check($db) else ($e) {
    die("wiring: {$e}");
};

// fresh tables and a few rows, every run
carbon::Session $session = $db->session();
array<string> $schema = [
    'DROP TABLE IF EXISTS comments',
    'DROP TABLE IF EXISTS posts',
    'DROP TABLE IF EXISTS users',
    'CREATE TABLE users (id BIGINT AUTO_INCREMENT PRIMARY KEY, email VARCHAR(190) NOT NULL, first_name VARCHAR(100) NOT NULL, last_name VARCHAR(100) NOT NULL, show_last_name TINYINT(1) NOT NULL DEFAULT 0, created_at DATETIME NULL)',
    'CREATE TABLE posts (id BIGINT AUTO_INCREMENT PRIMARY KEY, author_id BIGINT NOT NULL, title VARCHAR(200) NOT NULL, body TEXT NOT NULL, status TINYINT UNSIGNED NOT NULL DEFAULT 0, tags VARCHAR(200) NOT NULL DEFAULT \'\', created_at DATETIME NULL)',
    'CREATE TABLE comments (id BIGINT AUTO_INCREMENT PRIMARY KEY, post_id BIGINT NOT NULL, author_id BIGINT NOT NULL, body TEXT NOT NULL)',
];
foreach ($schema as const &$sql) {
    guard $db->run($sql) else ($e) {
        die("schema: {$e}");
    };
}
UserRepository $users = guard $session->repo<UserRepository>();
PostRepository $posts = guard $session->repo<PostRepository>();
CommentRepository $comments = guard $session->repo<CommentRepository>();
User $mario = guard $users->create(User($email: 'mario@example.com', $firstName: 'Mario', $lastName: 'Doering'));
User $ray = guard $users->create(User($email: 'ray@example.com', $firstName: 'Ray', $lastName: 'Stone', $showLastName: true));
Post $hello = guard $posts->create(Post($authorId: $mario->id, $title: 'Hello rest', $body: 'Resources, mappings and includes, generated from attributes', $status: .published, $tags: ['echo', 'rest']));
Post $again = guard $posts->create(Post($authorId: $ray->id, $title: 'Carbon underneath', $body: 'Eager loads fill the slots the mapping reads', $status: .published, $tags: ['carbon']));
guard $posts->create(Post($authorId: $ray->id, $title: 'Unfinished', $body: 'Only Ray sees this title', $tags: []));
guard $comments->create(Comment($postId: $hello->id, $authorId: $ray->id, $body: 'Nice one'));
guard $comments->create(Comment($postId: $hello->id, $authorId: $mario->id, $body: 'Thanks'));
guard $comments->create(Comment($postId: $again->id, $authorId: $mario->id, $body: 'Fast'));

// from here on the DB and the container are shared by every request thread
$db->seal();
container::Container $app = blog::App::container($db);
http::Server $server = http::Server();
blog::App::routes($app, $server);

io::println("listening on 127.0.0.1:{$port}");
guard $server->listen('127.0.0.1', $port) else ($e) {
    die("listen: {$e}");
};
