namespace restgen;

/**
 * Writes `.rest/models.eco` for a checked Program: per resource with
 * #[rest::from] its mapping interface, in the resource's namespace, then
 * one `encode` overload per resource and a case-name helper per enum
 * without a backing, in the library's. The output is deterministic, sorted
 * by qualified name, so `restgen check` can compare it byte for byte.
 */
public class Emitter
{
    private Program $program;
    private string $out = '';
    private int32 $counter = 0;
    private string $stamp = '';

    public constructor(Program $program)
    {
        $this->program = $program;
    }

    public function render() : string
    {
        $this->out = '';
        $this->line(0, '/**');
        $this->line(0, ' * Generated by restgen from the #[rest::model] declarations of this');
        $this->line(0, ' * module. Do not edit; run `restgen` again instead.');
        $this->line(0, ' */');

        map<string, bool> $spaces = [];
        foreach ($this->program->resources as const &$r) {
            if (!$r->from->empty()) {
                $spaces[$r->space()] = true;
            }
        }
        array<string> $sorted = $spaces->keys();
        $sorted->sort();
        foreach ($sorted as const &$space) {
            $this->line(0, '');
            $this->line(0, "namespace {$space};");
            foreach ($this->program->resources as const &$r) {
                if (!$r->from->empty() && $r->space() == $space) {
                    $this->mapping($r);
                }
            }
        }

        $this->line(0, '');
        $this->line(0, 'namespace EchoPack::Rest;');
        map<string, bool> $plain = [];
        foreach ($this->program->resources as const &$r) {
            foreach ($r->fields as const &$f) {
                if (!$f->skip) {
                    $this->plains($f->ty, $plain);
                }
            }
        }
        array<string> $enums = $plain->keys();
        $enums->sort();
        foreach ($enums as const &$e) {
            $this->caseName($this->program->enums->get($e));
        }
        foreach ($this->program->resources as const &$r) {
            $this->encoder($r);
        }
        return $this->out;
    }

    /**
     * The mapping interface of a resource with #[rest::from].
     */
    private function mapping(const Resource& $r) : void
    {
        string $local = Names::local($r->mapping());
        string $ctx = 'EchoPack::Rest::Context& $ctx';
        $this->line(0, '');
        $this->line(0, '/**');
        $this->line(0, " * How a {$r->from} becomes a {$r->qualified}. A transformer conforms,");
        $this->line(0, ' * writes the computed fields, and is added to the rest::Transformers as');
        $this->line(0, " * `add<{$local}>(...)`.");
        $this->line(0, ' */');
        $this->line(0, "{$r->visibility} interface {$local}");
        $this->line(0, '{');

        foreach ($r->computed() as const &$f) {
            string $returns = $f->ty->spell;
            if (!$f->include->empty()) {
                $returns = $f->inner()->spell;
            }
            $this->line(1, '/**');
            if ($f->include->empty()) {
                $this->line(1, " * The `{$f->key}` field.");
            } else {
                $this->line(1, " * The `{$f->key}` field, written when `{$f->include}` is asked for.");
            }
            $this->line(1, ' */');
            $this->line(1, "function {$f->name}(const {$r->from}& $source, {$ctx}) : {$returns};");
            $this->line(0, '');
        }

        $this->counter = 0;
        $this->line(1, '/**');
        $this->line(1, ' * Build the resource: copied fields, nested resources through their');
        $this->line(1, ' * mappings, relations once loaded, computed fields, then `refine`.');
        $this->line(1, ' */');
        $this->line(1, "function transform(const {$r->from}& $source, {$ctx}) : {$r->qualified}");
        $this->line(1, '{');
        array<string> $args = [];
        foreach ($r->fields as const &$f) {
            if (!$f->skip) {
                $args[] = "${$f->name}: {$this->fill($r, $f)}";
            }
        }
        if ($args->count() == 0) {
            $this->line(2, "{$r->qualified} $resource = {$r->qualified}();");
        } else {
            $this->line(2, "{$r->qualified} $resource = {$r->qualified}(");
            $this->commaLines(3, $args);
            $this->line(2, ');');
        }
        $this->line(2, '$this->refine($resource, $source, $ctx);');
        $this->line(2, 'return $resource;');
        $this->line(1, '}');

        $this->line(0, '');
        $this->line(1, "function many(const array<{$r->from}>& $sources, {$ctx}) : array<{$r->qualified}>");
        $this->line(1, '{');
        $this->line(2, "array<{$r->qualified}> $out = [];");
        $this->line(2, 'foreach ($sources as const &$source) {');
        $this->line(3, '$out[] = $this->transform($source, $ctx);');
        $this->line(2, '}');
        $this->line(2, 'return $out;');
        $this->line(1, '}');

        $this->line(0, '');
        $this->line(1, "function maybe({$r->from}? $source, {$ctx}) : {$r->qualified}?");
        $this->line(1, '{');
        $this->line(2, "{$r->from} $present = guard $source else {");
        $this->line(3, 'return null;');
        $this->line(2, '};');
        $this->line(2, 'return $this->transform($present, $ctx);');
        $this->line(1, '}');

        $this->line(0, '');
        $this->line(1, '/**');
        $this->line(1, ' * Adjust the built resource, for what depends on the viewer. Does');
        $this->line(1, ' * nothing unless the transformer overrides it.');
        $this->line(1, ' */');
        $this->line(1, "function refine({$r->qualified}& $resource, const {$r->from}& $source, {$ctx}) : void");
        $this->line(1, '{');
        $this->line(1, '}');
        $this->line(0, '}');
    }

    /**
     * The constructor argument for one field. Fields that need statements
     * first write them and answer with the local they fill.
     */
    private function fill(const Resource& $r, const Field& $f) : string
    {
        string $local = '$v';
        $local->append(Names::upper($f->name));
        string $spell = $f->ty->spell;

        if ($f->computed) {
            string $call = "$this->{$f->name}($source, $ctx)";
            if ($f->include->empty()) {
                return $call;
            }
            $this->line(2, "{$spell} {$local} = .absent();");
            $this->line(2, "if ($ctx->wants('{$f->include}')) \{");
            $this->line(3, "{$local} = .of({$call});");
            $this->line(2, '}');
            return $local;
        }

        string $field = "$source->{$f->from}";
        bool $include = $f->ty->kind == Kind::include;

        if ($f->access == Access::plain && !$include) {
            if ($f->conv == Conv::copy) {
                return $field;
            }
            $this->line(2, "if (!$ctx->enter('{$f->key}')) \{");
            $this->line(3, "die('rest: {$r->qualified}.{$f->name} nests deeper than the context allows; make it a rest::Include');");
            $this->line(2, '}');
            $this->line(2, "{$spell} {$local} = {$this->convert($f, $field)};");
            $this->line(2, '$ctx->leave();');
            return $local;
        }

        // an include is written when the request asks for it, a relation once it is loaded too
        array<string> $when = [];
        string $got = $field;
        if ($f->access != Access::plain) {
            $when[] = "{$field}->loaded()";
            $got = "{$field}->get()";
        }
        $when[] = "$ctx->wants('{$f->key}')";
        bool $nests = $f->conv != Conv::copy;
        if ($nests) {
            $when[] = "$ctx->enter('{$f->key}')";
        }

        string $condition = str::join($when, ' && ');
        $this->line(2, "{$spell} {$local} = .absent();");
        $this->line(2, "if ({$condition}) \{");
        if ($f->access == Access::resolved && $f->conv == Conv::many) {
            string $held = $this->fresh('$v');
            string $list = $this->fresh('$v');
            $this->line(3, "{$f->sourceSpell}? {$held} = {$got};");
            $this->line(3, "if ({$held} == null) \{");
            $this->line(4, "{$local} = .none();");
            $this->line(3, '} else {');
            $this->line(4, "{$f->sourceSpell} {$list} = guard {$held};");
            $this->line(4, "{$local} = .of({$this->convert($f, $list)});");
            $this->line(3, '}');
        } else {
            $this->line(3, "{$local} = .of({$this->convert($f, $got)});");
        }
        if ($nests) {
            $this->line(3, '$ctx->leave();');
        }
        $this->line(2, '}');
        return $local;
    }

    /**
     * `$value` through the field's conversion.
     */
    private const function convert(const Field& $f, const string& $value) : string
    {
        string $through = "$ctx->transformers->get<{$f->mapping}>()";
        return match ($f->conv) {
            Conv::copy => $value,
            Conv::transform => "{$through}->transform({$value}, $ctx)",
            Conv::maybe => "{$through}->maybe({$value}, $ctx)",
            Conv::many => "{$through}->many({$value}, $ctx)",
        };
    }

    private function encoder(const Resource& $r) : void
    {
        $this->counter = 0;
        $this->line(0, '');
        $this->line(0, '/**');
        $this->line(0, " * Encode a {$r->qualified} as the entity '{$r->entity}'.");
        $this->line(0, ' */');
        $this->line(0, "{$r->visibility} function encode<D : Driver>(const {$r->qualified}& $m, D& $d) : void");
        $this->line(0, '{');
        $this->line(1, "$d->open('{$r->entity}');");
        // attributes first, so a driver that writes them into the start tag still can
        foreach ($r->fields as const &$f) {
            if ($f->attribute) {
                $this->field($f);
            }
        }
        foreach ($r->fields as const &$f) {
            if (!$f->attribute) {
                $this->field($f);
            }
        }
        $this->line(1, '$d->close();');
        $this->line(0, '}');
    }

    private function field(const Field& $f) : void
    {
        if ($f->skip) {
            return;
        }
        $this->stamp = $f->stamp;
        string $call = 'key';
        if ($f->attribute) {
            $call = 'attribute';
        }
        string $expr = "$m->{$f->name}";
        if ($f->ty->kind == Kind::include) {
            $this->line(1, "if ({$expr}->present()) \{");
            $this->line(2, "$d->{$call}('{$f->key}');");
            $this->wrap($f, 2, true);
            if ($f->whole()) {
                $this->line(2, "encode({$expr}, $d);");
            } else {
                string $v = $this->fresh('$v');
                Ty $maybe = Ty($kind: Kind::optional, $spell: "{$f->inner()->spell}?", $of: $f->inner());
                // spelled out: echoc infers nothing through the generic get()
                $this->line(2, "{$maybe->spell} {$v} = {$expr}->get();");
                $this->value($v, $maybe, 2, $f->item);
            }
            $this->wrap($f, 2, false);
            $this->line(1, '}');
            return;
        }
        Ty $ty = $f->ty;
        int32 $depth = 1;
        if ($f->optional) {
            string $v = $this->fresh('$v');
            $this->line(1, "if ({$expr} != null) \{");
            $this->line(2, "{$v} = guard {$expr};");
            $expr = $v;
            $ty = $f->ty->element();
            $depth = 2;
        }
        $this->line($depth, "$d->{$call}('{$f->key}');");
        $this->wrap($f, $depth, true);
        $this->value($expr, $ty, $depth, $f->item);
        $this->wrap($f, $depth, false);
        if ($f->optional) {
            $this->line(1, '}');
        }
    }

    /**
     * #[rest::wrap]: the value goes under `data` in an object of its own.
     */
    private function wrap(const Field& $f, int32 $depth, bool $opening) : void
    {
        if (!$f->wrap) {
            return;
        }
        if ($opening) {
            $this->line($depth, "$d->open('item');");
            $this->line($depth, "$d->key('data');");
        } else {
            $this->line($depth, '$d->close();');
        }
    }

    /**
     * The driver calls for one value. `$item` names a list's elements.
     */
    private function value(const string& $expr, const Ty& $ty, int32 $depth, const string& $item) : void
    {
        string $as = '';
        if ($ty->cast && $ty->kind == Kind::floating) {
            $as = ' as float64';
        } else if ($ty->cast) {
            $as = ' as int64';
        }
        match ($ty->kind) {
            Kind::boolean => {
                $this->line($depth, "$d->bool({$expr});");
            },
            Kind::integer => {
                $this->line($depth, "$d->int({$expr}{$as});");
            },
            Kind::floating => {
                $this->line($depth, "$d->float({$expr}{$as});");
            },
            Kind::text => {
                $this->line($depth, "$d->str({$expr});");
            },
            Kind::backed => {
                $this->value("{$expr}->value()", $ty->element(), $depth, $item);
            },
            Kind::plain => {
                $this->line($depth, "$d->str(caseName({$expr}));");
            },
            Kind::value => {
                $this->line($depth, "$d->value({$expr});");
            },
            Kind::time => {
                if ($this->stamp->empty()) {
                    $this->line($depth, "encode({$expr}, $d);");
                } else {
                    $this->line($depth, "$d->str(Stamp::{$this->stamp}->render({$expr}));");
                }
            },
            Kind::model => {
                $this->line($depth, "encode({$expr}, $d);");
            },
            Kind::optional => {
                $this->optional($expr, $ty, $depth, $item);
            },
            Kind::list => {
                $this->list($expr, $ty, $depth, $item);
            },
            Kind::dict => {
                $this->dict($expr, $ty, $depth);
            },
            Kind::include => {
                // refused by Program below the top of a field
            },
            Kind::unknown => {
                // refused by Program before anything is emitted
            },
        }
    }

    private function optional(const string& $expr, const Ty& $ty, int32 $depth, const string& $item) : void
    {
        string $v = $this->fresh('$v');
        $this->line($depth, "if ({$expr} == null) \{");
        $this->line($depth + 1, '$d->nil();');
        $this->line($depth, '} else {');
        $this->line($depth + 1, "{$ty->element()->spell} {$v} = guard {$expr};");
        $this->value($v, $ty->element(), $depth + 1, $item);
        $this->line($depth, '}');
    }

    private function list(const string& $expr, const Ty& $ty, int32 $depth, const string& $item) : void
    {
        string $name = $item->clone();
        if ($name->empty()) {
            $name = $this->entity($ty->element());
        }
        string $i = $this->fresh('$i');
        $this->line($depth, "$d->list('{$name}');");
        $this->line($depth, "foreach ({$expr} as const &{$i}) \{");
        $this->value($i, $ty->element(), $depth + 1, '');
        $this->line($depth, '}');
        $this->line($depth, '$d->close();');
    }

    private function dict(const string& $expr, const Ty& $ty, int32 $depth) : void
    {
        string $key = $this->fresh('$key');
        $this->line($depth, "$d->open('item');");
        if ($ty->ordered) {
            string $v = $this->fresh('$v');
            $this->line($depth, "foreach ({$expr} as {$key} => const &{$v}) \{");
            $this->line($depth + 1, "$d->key({$key});");
            $this->value($v, $ty->element(), $depth + 1, '');
        } else {
            // a hash map has no order of its own, so the output gets one
            string $keys = $this->fresh('$keys');
            $this->line($depth, "array<string> {$keys} = {$expr}->keys();");
            $this->line($depth, "{$keys}->sort();");
            $this->line($depth, "foreach ({$keys} as const &{$key}) \{");
            $this->line($depth + 1, "$d->key({$key});");
            $this->value("{$expr}->get({$key})", $ty->element(), $depth + 1, '');
        }
        $this->line($depth, '}');
        $this->line($depth, '$d->close();');
    }

    /**
     * What one element of a list is called when the field does not say:
     * a resource's entity name, else `item`.
     */
    private const function entity(const Ty& $ty) : string
    {
        Ty $bare = $ty->bare();
        if ($bare->kind != Kind::model) {
            return 'item';
        }
        Resource $r = guard $this->program->resource($bare->name) else {
            return 'item';
        };
        return $r->entity;
    }

    private function caseName(const EnumInfo& $e) : void
    {
        $this->line(0, '');
        $this->line(0, '/**');
        $this->line(0, " * The wire name of a {$e->qualified}: its case name.");
        $this->line(0, ' */');
        $this->line(0, "internal function caseName(const {$e->qualified}& $e) : string");
        $this->line(0, '{');
        $this->line(1, 'return match ($e) {');
        foreach ($e->cases as const &$c) {
            $this->line(2, "{$e->qualified}::{$c} => '{$c}',");
        }
        $this->line(1, '};');
        $this->line(0, '}');
    }

    private function plains(const Ty& $ty, map<string, bool>& $into) : void
    {
        if ($ty->kind == Kind::plain) {
            $into[$ty->name] = true;
            return;
        }
        if ($ty->kind == Kind::optional || $ty->kind == Kind::list || $ty->kind == Kind::dict || $ty->kind == Kind::include) {
            $this->plains($ty->element(), $into);
        }
    }

    private function fresh(const string& $prefix) : string
    {
        $this->counter = $this->counter + 1;
        return "{$prefix}{$this->counter}";
    }

    /**
     * One line per item at `$depth`, commas between them.
     */
    private function commaLines(int32 $depth, const array<string>& $items) : void
    {
        string $indent = str::repeat('    ', $depth as usize);
        $this->line($depth, str::join($items, ",\n{$indent}"));
    }

    private function line(int32 $depth, const string& $text) : void
    {
        if (!$text->empty()) {
            $this->out->append(str::repeat('    ', $depth as usize));
            $this->out->append($text);
        }
        $this->out->append("\n");
    }
}
